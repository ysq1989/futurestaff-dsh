# DeepSeek Harness home used by `npm run profile:install` and Docker.
DSH_HOME=.dsh
DSH_HOST=127.0.0.1
DSH_PORT=3080
DSH_TRUSTED_HOST=dsh.fsstory.net

# One container and Product Hub Agent Key represent exactly one subject in Alpha.
FUTURESTAFF_IDENTITY_MODE=single-subject
FUTURESTAFF_TENANT_ID=tenant-development
FUTURESTAFF_USER_ID=user-development
FUTURESTAFF_DEVICE_ID=

# Configure the model/provider using the variables supported by your DSH release.
# Never commit real credentials.
DEEPSEEK_API_KEY=

# Preferred authenticated Product Hub Streamable HTTP MCP.
# When both values are present, the provisional Selection Center stdio adapter is disabled.
PRODUCT_HUB_MCP_URL=
PRODUCT_HUB_AGENT_KEY=

# M2 Selection Center upstream adapter.
SELECTION_CENTER_BASE_URL=https://selection-center.example.com/
SELECTION_CENTER_API_KEY=
SELECTION_CENTER_TIMEOUT_MS=10000
SELECTION_CENTER_MOCK_PORT=3301
SELECTION_CENTER_MOCK_HOST=127.0.0.1

# Optional Local Runner gateway. The Compose service remains disabled unless
# started with --profile runner. This file contains digests, never raw tokens.
RUNNER_GATEWAY_PORT=3090
RUNNER_GATEWAY_CONFIG_FILE=../runner-bindings.json
RUNNER_GATEWAY_INTERNAL_URL=http://127.0.0.1:3090/
RUNNER_DISPATCH_TOKEN=
RUNNER_ID=runner-example
RUNNER_DEVICE_ID=office-pc
RUNNER_DISPATCH_TIMEOUT_MS=30000
RUNNER_ENROLLMENT_OFFERS_FILE=../runner-enrollment.example.json
RUNNER_PUBLIC_URL=wss://dsh.fsstory.net/runner/v1/connect
