# DeepSeek Harness home used by `npm run profile:install` and Docker.
DSH_HOME=.dsh
DSH_HOST=127.0.0.1
DSH_PORT=3080

# Bootstrap identity only. A trusted gateway should provide request identity later.
FUTURESTAFF_TENANT_ID=tenant-development
FUTURESTAFF_USER_ID=user-development
FUTURESTAFF_DEVICE_ID=

# Configure the model/provider using the variables supported by your DSH release.
# Never commit real credentials.
DEEPSEEK_API_KEY=
